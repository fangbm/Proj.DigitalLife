# Reference only: export these variables in your shell. Do not commit real keys.
PHONE_LIFE_API_BASE=https://your-provider.example/v1
PHONE_LIFE_API_KEY=replace_me
PHONE_LIFE_BRAIN_MODEL=your-chat-model
PHONE_LIFE_GUI_MODEL=your-vision-model
PHONE_LIFE_JSON_MODE=auto
# Optional: use a separate local vision server. Defaults to the brain endpoint/key.
PHONE_LIFE_GUI_API_BASE=http://127.0.0.1:8000/v1
PHONE_LIFE_GUI_API_KEY=your-local-key
PHONE_LIFE_PERSONA_PATH=./persona.example.md
PHONE_LIFE_EMULATOR_SERIAL=emulator-5554
PHONE_LIFE_REAL_SERIAL=replace_with_adb_serial
PHONE_LIFE_DB=./data/phone-life.sqlite3
PHONE_LIFE_ALLOWED_APPS=com.android.chrome,tv.danmaku.bili


# All real executors for one device must share this lease coordinator, even with separate state DBs.
PHONE_LIFE_LEASE_DB=./data/phone-life.sqlite3
# API autonomous cycles use Phase 1.2 by default. Configure limits with CLI flags; see docs.
